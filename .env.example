# Fleex 3PL Platform — environment variables.
#
# Copy this file to `.env.local` for local development (`.env.local` is
# gitignored). Never commit a real secret.
#
# Per CLAUDE.md: update this file whenever a new env variable is introduced.

# ---------------------------------------------------------------------------
# Milestone 0.2 — Database (Neon Postgres)
# ---------------------------------------------------------------------------

# Pooled connection (pgBouncer, transaction mode). Used by the app at runtime.
# Neon dashboard → Connect → "Connection pooling" ON.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Direct connection (no pooler). Used by Prisma for `migrate dev` (shadow DB).
# Neon dashboard → Connect → "Connection pooling" OFF.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ---------------------------------------------------------------------------
# Milestone 0.3 — Clerk auth
# ---------------------------------------------------------------------------

# Publishable key — safe to embed in client-side bundles.
# Clerk dashboard → Configure → API Keys → Publishable key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"

# Secret key — server-side only. Never exposed to the browser.
# Clerk dashboard → Configure → API Keys → Secret keys → Show.
CLERK_SECRET_KEY="sk_test_REPLACE_ME"

# Optional later: webhook secret for `user.created` → DB sync.
# Configure when we add webhook-driven user provisioning (post-0.3).
# CLERK_WEBHOOK_SECRET="whsec_REPLACE_ME"

