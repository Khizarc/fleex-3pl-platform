// ============================================================================
// Fleex 3PL Platform — Core Prisma Schema (Phase 0)
// ============================================================================
//
// SCOPE: This file covers ONLY the core tenancy entities needed for Phase 0:
//   Company, User, Client, ClientUser, plus the Role enum and the
//   multi-tenancy scaffolding.
//
// Feature entities (Warehouse, Bin, Product, Order, Invoice, etc.) are added
// in later phases — see docs/ARCHITECTURE.md §4 for the full planned data model.
//
// MULTI-TENANCY: Every table except `Company` carries `companyId` (the owning
// 3PL — this is the `tenant_id`). Row-Level Security (RLS) policies are applied
// via raw SQL migrations on top of this schema — Prisma defines the tables,
// SQL migrations define the RLS policies. See the note at the bottom of this
// file and docs/ARCHITECTURE.md §3.
//
// REVIEW THIS before running the first migration. The schema is the spine of
// the app — getting it right on paper is cheaper than changing it later.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // native = host (macOS dev). linux-musl-openssl-3.0.x = Vercel / Alpine CI runners.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL is the pooled connection (pgBouncer transaction mode) — used at runtime.
  url       = env("DATABASE_URL")
  // DIRECT_URL bypasses the pooler — used by `prisma migrate` for shadow DB ops.
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

/// Roles for a 3PL company's own staff (Warehouse Dashboard users).
/// Client-side portal users are a separate model (ClientUser) and are not
/// given these roles.
enum Role {
  ADMIN // Full access to the company's account and settings
  RECEIVER // Checks in inbound inventory
  PICKER // Picks items for orders
  PACKER // Packs picked orders
  SHIPPER // Generates labels and ships orders
}

/// Lifecycle status shared by Company, User, Client, and ClientUser.
/// Soft-disable rather than hard-delete so audit history stays intact.
enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

/// State machine for InboundShipment (Milestone 1.3). Legal transitions are
/// validated at the service layer via features/inbound/state-machine.ts.
enum InboundShipmentStatus {
  NOTIFIED // client created the notice
  RECEIVING // staff has started checking it in
  COMPLETED // done, every line matches expected
  COMPLETED_WITH_DISCREPANCIES // done, at least one line's actual ≠ expected
}

/// Status of a StockLevel row. Splitting available vs reserved vs on_hold vs
/// damaged into separate rows keeps each transition clean and running totals
/// trivially queryable (one row per (sku, bin, status)).
enum StockLevelStatus {
  AVAILABLE
  RESERVED
  ON_HOLD
  DAMAGED
}

/// State machine for Order (Milestone 1.5). The full lifecycle is declared
/// here so the schema is stable across 1.5–1.10; only the subset of transitions
/// needed by 1.5 is wired in features/orders/state-machine.ts. Same staged
/// approach as InboundShipmentStatus.
enum OrderStatus {
  DRAFT // reserved for future "save before submit" — not used in 1.5
  SUBMITTED // entry state from createOrder
  AWAITING_STOCK // allocation tried but failed — needs more inbound
  READY_TO_PICK // fully allocated, waiting for pick run
  PICKING // 1.8
  PICKED // 1.8
  PACKING // 1.9
  PACKED // 1.9
  READY_TO_SHIP // 1.9
  SHIPPED // 1.10
  IN_TRANSIT // 1.10 (carrier webhook)
  DELIVERED // 1.10 (carrier webhook)
  CANCELLED // terminal
  ON_HOLD // staff-controlled hold — future
  EXCEPTION // future
  PARTIALLY_SHIPPED // future (split shipments)
}

// ============================================================================
// CORE TENANCY ENTITIES
// ============================================================================

/// A 3PL business using the platform — the paying customer and the top-level
/// tenant. This is the ONLY table without a `companyId`, because it IS the
/// company. Everything else belongs to a Company.
model Company {
  id        String        @id @default(cuid())
  name      String
  status    AccountStatus @default(ACTIVE)

  // --- White-labeling / branding (used by the Client Portal in Phase 5) ---
  // Present from the start so later phases don't need a migration to add them.
  logoUrl      String?
  brandName    String? // Defaults to `name` if not set
  primaryColor String? // Hex color for portal theming

  // --- Relations ---
  users      User[]
  clients    Client[]
  warehouses Warehouse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// A staff member of a 3PL Company — a Warehouse Dashboard user.
/// Authentication itself is handled by Clerk; this record stores the
/// application-side identity, role, and tenant linkage. `authProviderId`
/// links this row to the Clerk user.
model User {
  id             String        @id @default(cuid())
  authProviderId String        @unique // Clerk user ID
  email          String
  name           String
  role           Role
  status         AccountStatus @default(ACTIVE)

  // --- Tenancy: the owning 3PL company (this is the tenant_id) ---
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // --- Relations (Milestone 1.3+) ---
  receivedInboundLines InboundShipmentLine[] @relation("ReceivedBy")
  createdOrders        Order[]               @relation("CreatedByStaff")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Email is unique per company, not globally — two different 3PLs could
  // each have a staff member with the same email.
  @@unique([companyId, email])
  @@index([companyId])
  @@index([authProviderId])
}

/// A customer of a 3PL Company — the business whose inventory the 3PL stores
/// and whose orders it fulfills. Clients log into the Client Portal.
///
/// This is the SECOND level of tenancy: a Client must only ever see its own
/// data, never another Client's, never the Company's internal operations.
/// Feature tables added in later phases (Order, Product, etc.) will carry
/// BOTH `companyId` and `clientId` so both boundaries can be enforced.
model Client {
  id     String        @id @default(cuid())
  name   String
  status AccountStatus @default(ACTIVE)

  // --- Tenancy: the owning 3PL company (this is the tenant_id) ---
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // --- Relations ---
  clientUsers      ClientUser[]
  products         Product[]
  inboundShipments InboundShipment[]
  orders           Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Client name is unique per company, not globally.
  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
}

/// A login identity for a Client — a person at the client business who uses
/// the Client Portal. A Client may have several ClientUsers.
/// Authentication is handled by Clerk; `authProviderId` links to the Clerk user.
model ClientUser {
  id String @id @default(cuid())
  /// Clerk user ID. NULL until the invitee signs up and claim-by-email links
  /// the row (lib/auth/current-user.ts). PostgreSQL treats multiple NULLs as
  /// distinct, so the @unique constraint still permits multiple unclaimed rows.
  authProviderId String?       @unique
  email          String
  name           String
  status         AccountStatus @default(ACTIVE)

  // --- Tenancy ---
  // Denormalized `companyId` is intentional: it lets RLS policies and queries
  // enforce the company boundary without always joining through Client.
  // It must always equal `client.companyId` — enforce this in the service layer.
  companyId String
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // --- Relations (Milestone 1.5+) ---
  createdOrders Order[] @relation("CreatedByClientUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Email is unique per client.
  @@unique([clientId, email])
  @@index([clientId])
  @@index([companyId])
  @@index([authProviderId])
}

// ============================================================================
// WAREHOUSE STRUCTURE (Milestone 1.1)
// ============================================================================
// Four-level nesting: Warehouse → Zone → Aisle → Bin. Each level carries
// `companyId` (denormalized from the parent) so RLS policies filter without
// joining. The service layer derives child `companyId` from the parent —
// always — and RLS WITH CHECK provides defense-in-depth at the DB level.

/// A physical warehouse location belonging to a Company.
model Warehouse {
  id      String        @id @default(cuid())
  name    String
  address String?
  status  AccountStatus @default(ACTIVE)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  zones            Zone[]
  inboundShipments InboundShipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

/// A logical area inside a Warehouse (e.g., "Receiving", "Shipping", "Cold").
model Zone {
  id   String @id @default(cuid())
  name String

  warehouseId String
  // Denormalized from warehouse.companyId — must always match.
  companyId   String

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  aisles    Aisle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, name])
  @@index([companyId])
  @@index([warehouseId])
}

/// A row of bins within a Zone (e.g., "A1", "B2").
model Aisle {
  id   String @id @default(cuid())
  name String

  zoneId    String
  companyId String // denormalized from zone.companyId

  zone Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  bins Bin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, name])
  @@index([companyId])
  @@index([zoneId])
}

/// A single storage location (e.g., "A1-01"). Inventory lives in bins.
model Bin {
  id     String        @id @default(cuid())
  label  String
  status AccountStatus @default(ACTIVE)

  aisleId   String
  companyId String // denormalized from aisle.companyId

  aisle                Aisle                 @relation(fields: [aisleId], references: [id], onDelete: Cascade)
  stockLevels          StockLevel[]
  inboundShipmentLines InboundShipmentLine[]
  orderLineAllocations OrderLineAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([aisleId, label])
  @@index([companyId])
  @@index([aisleId])
}

// ============================================================================
// PRODUCT CATALOG (Milestone 1.2)
// ============================================================================
// Products are owned by a Client (the client owns the goods). SKUs are the
// atomic units of inventory: a product can have many SKUs (variants).
// Both tables are two-level tenant-scoped (companyId + clientId), so the
// USING clauses enforce the Company + optional Client filter — same pattern
// as `Client` and `ClientUser`.

/// A sellable product belonging to a Client. Definition only — quantities
/// live in StockLevel (Milestone 1.4+).
model Product {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      AccountStatus @default(ACTIVE)

  clientId  String
  // Denormalized from client.companyId — must always match.
  companyId String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  skus   SKU[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, name])
  @@index([clientId])
  @@index([companyId])
}

/// A specific variant of a Product (e.g., "Acme Tee · Red · Large").
/// SKU codes are unique within a client's catalog.
model SKU {
  id     String        @id @default(cuid())
  code   String
  name   String
  status AccountStatus @default(ACTIVE)

  productId String
  // Denormalized from product (which in turn denormalizes from client).
  clientId  String
  companyId String

  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevels          StockLevel[]
  inboundShipmentLines InboundShipmentLine[]
  orderLineItems       OrderLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, code])
  @@index([productId])
  @@index([clientId])
  @@index([companyId])
}

// ============================================================================
// INBOUND SHIPMENTS + STOCK LEVELS (Milestone 1.3)
// ============================================================================
// A client notifies the 3PL that inventory is coming. Staff receives it
// against bins. The act of receiving materializes StockLevel rows — the
// atomic unit of inventory (quantity of SKU in Bin, with status).
// Two-level tenant-scoped, same RLS pattern as Product/SKU.

/// A client's notice that inventory is on the way.
model InboundShipment {
  id                String                @id @default(cuid())
  reference         String?
  expectedArrivalAt DateTime?
  notes             String?
  status            InboundShipmentStatus @default(NOTIFIED)

  clientId    String
  companyId   String
  warehouseId String

  client    Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     InboundShipmentLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([companyId])
  @@index([warehouseId])
  @@index([status])
}

/// One line of an inbound shipment. expectedQuantity is set on creation;
/// actualQuantity / binId / receivedAt / receivedByUserId are set during
/// the staff receive workflow.
model InboundShipmentLine {
  id String @id @default(cuid())

  inboundShipmentId String
  skuId             String
  expectedQuantity  Int

  actualQuantity   Int?
  binId            String?
  receivedAt       DateTime?
  receivedByUserId String?
  notes            String?

  clientId  String // denormalized from inboundShipment.clientId
  companyId String // denormalized

  inboundShipment InboundShipment @relation(fields: [inboundShipmentId], references: [id], onDelete: Cascade)
  sku             SKU             @relation(fields: [skuId], references: [id], onDelete: Restrict)
  bin             Bin?            @relation(fields: [binId], references: [id], onDelete: Restrict)
  receivedBy      User?           @relation("ReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inboundShipmentId])
  @@index([skuId])
  @@index([clientId])
  @@index([companyId])
}

/// Quantity of a SKU in a Bin with a status. The atomic unit of inventory.
/// Splitting available/reserved/on_hold/damaged into separate rows keeps
/// state transitions clean and running totals trivial to query.
model StockLevel {
  id       String           @id @default(cuid())
  quantity Int
  status   StockLevelStatus @default(AVAILABLE)

  skuId String
  binId String

  clientId  String
  companyId String

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Restrict)
  bin Bin @relation(fields: [binId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skuId, binId, status])
  @@index([skuId])
  @@index([binId])
  @@index([clientId])
  @@index([companyId])
}

// ============================================================================
// ORDERS (Milestone 1.5)
// ============================================================================
// A client places an order with one or more line items and a single ship-to
// address. On submit, `allocateOrder` runs FIFO across bins for each line; the
// transaction is atomic — either every line fully allocates (status flips to
// READY_TO_PICK and OrderLineAllocation rows are written, StockLevel
// AVAILABLE → RESERVED) or nothing happens (status flips to AWAITING_STOCK).
// Two-level tenant-scoped, same RLS pattern as InboundShipment.

/// A request to ship a set of SKUs to one address. Ship-to is stored inline
/// (no separate Address table in 1.5 — saved address book is Phase 5).
/// `reference` is `ORD-YYYYMMDD-####` generated server-side at insert; unique
/// per company.
model Order {
  id            String      @id @default(cuid())
  reference     String
  status        OrderStatus @default(SUBMITTED)
  customerNote  String?

  // --- Inline ship-to address ---
  shipToName       String
  shipToLine1      String
  shipToLine2      String?
  shipToCity       String
  shipToRegion     String
  shipToPostalCode String
  shipToCountry    String

  // --- Lifecycle timestamps (set by service-layer transitions) ---
  submittedAt   DateTime  @default(now())
  allocatedAt   DateTime?
  cancelledAt   DateTime?

  // --- Tenancy ---
  clientId  String
  companyId String

  // --- Audit trail — who placed the order ---
  createdByUserId       String?
  createdByClientUserId String?

  client            Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByUser     User?       @relation("CreatedByStaff", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByClient   ClientUser? @relation("CreatedByClientUser", fields: [createdByClientUserId], references: [id], onDelete: SetNull)
  lines             OrderLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reference is unique per company so the daily sequence resets cleanly.
  @@unique([companyId, reference])
  @@index([clientId])
  @@index([companyId])
  @@index([status])
}

/// One line of an order — a SKU and the ordered quantity.
/// A SKU can only appear once per order (callers should combine).
model OrderLineItem {
  id       String @id @default(cuid())
  orderId  String
  skuId    String
  quantity Int

  // Denormalized from order — required for two-level RLS.
  clientId  String
  companyId String

  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         SKU                   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  allocations OrderLineAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, skuId])
  @@index([orderId])
  @@index([skuId])
  @@index([clientId])
  @@index([companyId])
}

/// One row per (orderLineItem, bin) the allocator pulled from. Written by
/// allocateOrder; deleted by cancelOrder (after restoring stock) or by 1.8
/// pick (when RESERVED converts to picked-out).
model OrderLineAllocation {
  id                String @id @default(cuid())
  orderLineItemId   String
  binId             String
  quantityReserved  Int

  // Denormalized from orderLineItem — required for two-level RLS.
  clientId  String
  companyId String

  orderLineItem OrderLineItem @relation(fields: [orderLineItemId], references: [id], onDelete: Cascade)
  bin           Bin           @relation(fields: [binId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderLineItemId, binId])
  @@index([orderLineItemId])
  @@index([binId])
  @@index([clientId])
  @@index([companyId])
}

// ============================================================================
// ROW-LEVEL SECURITY (RLS) — IMPLEMENTATION NOTE
// ============================================================================
//
// Prisma defines the TABLES above. It does NOT manage RLS policies — those are
// applied via raw SQL in migrations. For each tenant-scoped table, the Phase 0
// migration work includes:
//
//   1. ALTER TABLE "<table>" ENABLE ROW LEVEL SECURITY;
//   2. A policy restricting rows to the current tenant context, e.g.:
//
//        CREATE POLICY tenant_isolation ON "User"
//          USING ("companyId" = current_setting('app.current_company_id'));
//
//   3. The per-request tenant-context middleware sets `app.current_company_id`
//      (and, for portal requests, the client context) at the start of every
//      request — see docs/ARCHITECTURE.md §3.
//
// RULE (from CLAUDE.md): every new tenant-scoped table gets `companyId` PLUS an
// RLS policy IN THE SAME MIGRATION — never as a follow-up.
//
// Phase 0 is not done until an automated test proves Client A cannot read
// Client B's data through the API.
// ============================================================================
